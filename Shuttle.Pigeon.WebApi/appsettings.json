{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "azure": "UseDevelopmentStorage=true;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/.log",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 1048576,
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Shuttle": {
    "Access": {
      "Authorization": {
        "BaseAddress": "http://localhost:5599"
      }
    },
    "Hopper": {
      "AzureStorageQueues.": {
        "azure": {
          "StorageAccount": ""
        }
      },
      "RabbitMQ": {
        ".": {
          "Host": "localhost",
          "VirtualHost": "/",
          "Username": "guest",
          "Password": "guest"
        }
      },
      "MessageRoutes.azuresq": [
        {
          "Uri": "azuresq://azure/pigeon-server-work",
          "Specifications": [
            {
              "Name": "StartsWith",
              "Value": "Shuttle.Pigeon.Messages"
            }
          ]
        }
      ],
      "MessageRoutes": [
        {
          "Uri": "rabbitmq://./pigeon-server-work",
          "Specifications": [
            {
              "Name": "StartsWith",
              "Value": "Shuttle.Pigeon.Messages"
            }
          ]
        }
      ]
    }
  }
}